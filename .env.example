# ==============================================================================
# DAKLAK.TODAY - ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền các giá trị phù hợp với môi trường VPS của bạn.
# ==============================================================================

# Cấu hình Server (VPS Port 3028)
PORT=3028
NODE_ENV=production
SITE_URL=https://daklak.today
DEMO_SITE_URL=https://demo.daklak.today
JWT_SECRET=daklak_today_super_secret_jwt_key_2026_please_change

# Cấu hình Thương hiệu (Brand Identity)
APP_NAME=DakLak.today Platform
BRAND_NAME=DakLak.today
BRAND_SHORT_NAME=DakLak Today
AI_AGENT_NAME=AI Đắk Lắk Assistant
SUPPORT_EMAIL=contact@daklak.today

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=daklak_today_db

# Cấu hình Trí tuệ Nhân tạo Google Gemini (AI Chat & RAG)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cấu hình Gửi Email SMTP (Xác thực, Vé sự kiện, Thông báo duyệt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Ban Biên Tập DakLak.today
SMTP_FROM="DakLak.today" <contact@daklak.today>
